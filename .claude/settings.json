{
  "language": "japanese",
  "permissions": {
    "allow": [
      "Bash(./vendor/bin/sail artisan test *)",
      "Bash(./vendor/bin/sail test *)",
      "Bash(sail artisan test *)",
      "Bash(sail test *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "test -x vendor/bin/sail || exit 0; ./vendor/bin/sail artisan test >&2 || exit 2",
            "timeout": 300,
            "statusMessage": "テストを実行中..."
          }
        ]
      }
    ]
  }
}
