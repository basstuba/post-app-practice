{
  "language": "japanese",
  "permissions": {
    "allow": [
      "Bash(./vendor/bin/sail artisan test *)",
      "Bash(./vendor/bin/sail test *)",
      "Bash(sail artisan test *)",
      "Bash(sail test *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-tests-in-worktree.sh",
            "statusMessage": "worktree でのテスト実行を確認中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests.sh",
            "timeout": 300,
            "statusMessage": "テストを実行中..."
          }
        ]
      }
    ]
  }
}
